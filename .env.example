# ── Continuum · environment template ────────────────────────────────────────
# Copy to .env and fill in. Real environment variables override .env values.

# MongoDB Atlas (use "atlas"), or leave "memory" for the in-process mongomock.
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/?ssl=true&replicaSet=<set>&authSource=admin
MONGODB_DB=continuum
CONTINUUM_DB_MODE=memory

# LLM: any LangChain provider. Leave LLM_MODEL empty for a sensible default.
#   gemini (Google AI Studio key)      LLM_PROVIDER=gemini   LLM_API_KEY=<key>          → gemini-3.5-flash-lite
#   openai / OpenAI-compatible server  LLM_PROVIDER=openai   LLM_API_KEY / LLM_BASE_URL → gpt-4.1-mini
#   anthropic                          LLM_PROVIDER=anthropic LLM_API_KEY=<key>
# No key → deterministic extraction (the app still works end to end).
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Embeddings: auto follows LLM_PROVIDER (Gemini → Gemini embeddings, …) and falls
# back to a built-in local model (BAAI/bge-small-en-v1.5, CPU, no key).
# Also: local | none | openai | gemini | voyageai | cohere.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
# EMBEDDING_API_KEY=   (e.g. a Voyage key when EMBEDDING_PROVIDER=voyageai)

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
CONTINUUM_VOICE_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_PHONE_NUMBER=
# Phone-number id from ElevenLabs (Agents → Phone numbers); enables outbound check-in calls.
ELEVENLABS_PHONE_NUMBER_ID=
# Automated calls only go out inside this local-time window (end hour exclusive).
# Outside it, due check-ins wait; the sweep result lists them as "checkin_held".
# Set START = END to turn the window off (testing only).
CALL_TIMEZONE=America/Toronto
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=20
# Country code assumed for patient numbers saved without one. "1" completes
# 10-digit North American numbers; with any other value, save numbers as +<cc>….
DEFAULT_COUNTRY_CODE=1

# Text and email: patient check-ins (Text / Email / Portal channels) and
# paging the on-call clinician. SMS via Twilio, email via any SMTP relay.
# Point the Twilio number's messaging webhook at
#   https://<host>/api/messages/sms/inbound   (replies + STOP opt-out)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Urgent and emergency escalations page these by SMS and email at once
# (comma-separated for several). Re-paged until someone acknowledges.
ON_CALL_PHONE=
ON_CALL_EMAIL=
PAGE_ACK_MINUTES_EMERGENCY=10
PAGE_ACK_MINUTES_URGENT=30
PAGE_MAX_ATTEMPTS=3

# Clinic/lab FHIR intake (POST /api/integrations/fhir, header X-Continuum-Integration-Token).
INTEGRATION_SECRET=

# EHR ingestion (docs/ingestion.md). A FHIR R4 base URL turns on discharge pulls
# (POST /api/ingest/hl7 with ADT^A03, or /api/ingest/pull) and the result poller.
# Local sandbox: http://localhost:8080/fhir (HAPI + Synthea).
EHR_FHIR_BASE_URL=
# none | bearer | backend_jwt (SMART Backend Services, e.g. Epic "Backend Systems" apps)
EHR_AUTH_MODE=none
# EHR_BEARER_TOKEN=
# EHR_CLIENT_ID=
# EHR_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
# EHR_PRIVATE_KEY_PATH=/secrets/ehr-private-key.pem
# EHR_KEY_ID=
EHR_POLL_ENABLED=true
# MLLP listener for an interface engine's HL7 feed (0 = off; binds 127.0.0.1).
HL7_MLLP_PORT=0

# Proactive scheduler: places due check-ins, chases overdue and stale loops.
# 0 disables the background loop (POST /api/admin/sweep still works).
SCHEDULER_INTERVAL_SECONDS=300
OVERDUE_CHECKIN_AFTER_DAYS=1
OVERDUE_ESCALATE_AFTER_DAYS=7
STALE_REPORT_AFTER_DAYS=5

# Auth (demo accounts: coordinator@continuum.demo / continuum,
#              clinician@continuum.demo / continuum)
AUTH_SECRET=change-me
AUTH_TOKEN_TTL_MINUTES=600
DEMO_MODE=true
# DEMO_COORDINATOR_EMAIL=coordinator@continuum.demo
# DEMO_COORDINATOR_PASSWORD=continuum
# DEMO_COORDINATOR_NAME=Jordan Davis
# DEMO_CLINICIAN_EMAIL=clinician@continuum.demo
# DEMO_CLINICIAN_PASSWORD=continuum
# DEMO_CLINICIAN_NAME=Dr. Amara Osei

# PHI retention — days to keep operational records (events, evidence, voice
# transcripts, audit, memories) before they become purge-eligible. 0 disables.
PHI_RETENTION_DAYS=365

# CORS / URL (only needed when the console is served from another origin)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PUBLIC_APP_URL=http://localhost:5173
# ENVIRONMENT=development

# LangSmith: tracing turns on automatically when a key is set.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=continuum-hackathon
LANGCHAIN_PROJECT=continuum-hackathon
